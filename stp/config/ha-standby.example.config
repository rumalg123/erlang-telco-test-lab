[
    {telco_stp, [
        %% Replace both values before use. The fencing field is the raw
        %% 32-byte SHA-256 digest of the operator's promotion token.
        {ha, #{
            mode => standby,
            peers => ['stp_a@primary-host'],
            interval_ms => 1000,
            replication_timeout_ms => 2000,
            max_staleness_ms => 10000,
            max_clock_skew_ms => 5000,
            shared_secret =>
                <<"REPLACE-WITH-32-BYTE-SHARED-SECRET">>,
            fencing_token_sha256 => <<0:256>>,
            snapshot_path =>
                "/var/lib/telco_stp/standby.snapshot"
        }}
    ]}
].
