# Copy this file to the repository-root .env before using Compose.
#
# Set these to `id -u` and `id -g` on the Linux deployment host so the
# unprivileged container can write the bind-mounted runtime directories.
STP_UID=1000
STP_GID=1000

# Versioned OTP target-system paths. Change these only with a coordinated
# application/release upgrade and matching release artifacts.
STP_APP_VERSION=0.3.0
STP_RELEASE_VERSION=1.0

# Container resource ceilings. Prove/tune these during capacity testing.
STP_MEMORY_LIMIT=2g
STP_CPU_LIMIT=2.0

# `STP_SYSTEM_MODE=seed` non-destructively fills the host-mounted system tree
# from the complete image release. `host` requires that tree to be complete.
STP_SYSTEM_MODE=seed

# The separate ebin policy supports operator BEAM overlays. `seed` populates an
# empty app ebin, `host` requires host files, and `refresh` overwrites app files.
STP_EBIN_MODE=seed

# Keep true for real M3UA/M2PA. Set false only for a loopback-only lab.
STP_REQUIRE_SCTP=true

# Leave empty for standalone mode. HA nodes need resolvable unique names.
STP_NODE_NAME=
STP_COOKIE_FILE=

# Optional trusted one-off emulator flags. Static flags belong in vm.args.
STP_ERL_FLAGS=

RUN_ERL_LOG_GENERATIONS=20
RUN_ERL_LOG_MAXSIZE=10485760

# Pin deliberately. Review OTP release/security notes before changing it.
ERLANG_IMAGE=erlang:29.0.3.0-slim
RUNTIME_IMAGE=debian:trixie-slim
